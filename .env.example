# Aliyun Enterprise Mail. Fill these in Railway Variables, not in this file.
MAIL_IMAP_HOST=imap.qiye.aliyun.com
MAIL_IMAP_PORT=993
MAIL_IMAP_USER=stella.zhuang@chessnutech.com
MAIL_IMAP_PASSWORD=
MAIL_IMAP_TLS=true
MAIL_SMTP_HOST=smtp.qiye.aliyun.com
MAIL_SMTP_PORT=465
MAIL_SMTP_USER=stella.zhuang@chessnutech.com
MAIL_SMTP_PASSWORD=

# Public URL of the Railway service, used by GitHub Pages for sending replies.
KOL_API_BASE=
KOL_REPLY_TOKEN=

# Timezone and the scheduled mailbox scan time.
APP_TIMEZONE=Asia/Shanghai
SCAN_HOUR=8
SCAN_MINUTE=30

# Optional: comma-separated recipient emails for the daily digest.
DAILY_DIGEST_RECIPIENTS=

# YouTube Data API and OAuth (read-only key plus write-capable OAuth refresh token).
YOUTUBE_API_KEY=
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=
YOUTUBE_REFRESH_TOKEN=

# Instagram Graph API for an Instagram professional account connected to a Facebook Page.
META_GRAPH_VERSION=v22.0
INSTAGRAM_USER_ID=
INSTAGRAM_ACCESS_TOKEN=

# Protect dashboard write actions (reply, publish, comment replies).
KOL_ADMIN_TOKEN=
