    {
      "id": "d22a29540957757ffc35",
      "threadId": "partnership / sponsorship proposal – chess slovak open & slovak chess federation",
      "name": "Milan Roman",
      "email": "info@milanroman.sk",
      "subject": "Re: Partnership / sponsorship proposal – Chess Slovak Open & Slovak Chess Federation",
